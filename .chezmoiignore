{{- /* The 50800 proxy helpers (proxy, px) are only for servers. CCI sets the
       proxy globally in /etc/environment via the container bootstrap script,
       and desktop and mac have nothing on 50800. */ -}}
{{ if ne .machine "server" }}
.config/bash/11-proxy.bash
{{ end }}

{{ if ne .machine "mac" }}
.zshrc
{{ end }}

{{- /* User-level Xray only where we run our own proxy; Claude Code and
       Codex are routed through it (12-agents.bash). */}}
{{ if not (has .machine (list "desktop" "server")) }}
.config/bash/12-agents.bash
.config/systemd/user/xray.service
.local/bin/xray
.local/share/xray
.local/share/xray/**
{{ end }}
