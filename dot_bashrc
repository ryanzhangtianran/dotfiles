case $- in
    *i*) ;;
      *) return ;;
esac

# Modules in name order: 0x env, 1x aliases, 2x runtimes, 3x tools, 9x prompt.
# Files homie doesn't manage can be dropped in too (e.g. 50-project.bash).
for f in "$HOME"/.config/bash/*.bash; do
    [[ -r "$f" ]] && source "$f"
done

[[ -r "$HOME/.bashrc.local" ]] && source "$HOME/.bashrc.local"
