# ~/.zshrc

# ~/.config/zsh/NN-name.zsh, loaded in order. Tens digit is the group:
#   0x  base          env, completion
#   1x  user          aliases
#   2x  runtimes      fnm
#   3x  tools         fzf, zoxide, atuin, autosuggestions
#   9x  last          prompt (starship), syntax highlighting
for f in "$HOME"/.config/zsh/*.zsh(N); do
    source "$f"
done
unset f

[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
