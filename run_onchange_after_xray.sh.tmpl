{{- if has .machine (list "desktop" "server") -}}
#!/usr/bin/env bash
# Enable the user-level Xray service. Re-runs when the unit file changes:
# {{ include "private_dot_config/systemd/user/xray.service" | sha256sum }}
set -Eeuo pipefail

config="$HOME/.config/xray/config.json"

if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo '[dotfiles] No systemd user session; run Xray by hand:'
    echo "           XRAY_LOCATION_ASSET=~/.local/share/xray xray run -config $config"
    exit 0
fi

systemctl --user daemon-reload
systemctl --user enable xray.service

if [[ -r "$config" ]]; then
    systemctl --user restart xray.service
    echo '[dotfiles] Xray (user) restarted.'
else
    echo "[dotfiles] Xray enabled but not started: put your config at $config"
    echo '           (kept out of the dotfiles repo, it holds server secrets),'
    echo '           then run: systemctl --user start xray'
fi

if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
    echo '[dotfiles] Linger is off, so Xray stops when you log out. To keep it running:'
    echo '           loginctl enable-linger'
fi
{{- end }}
