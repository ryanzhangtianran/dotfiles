{{- if eq .machine "mac" -}}
#!/usr/bin/env bash
# Shell tools on macOS. Linux gets the same set from .chezmoiexternal.toml.
set -Eeuo pipefail

for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x "$brew" ]] && eval "$("$brew" shellenv)" && break
done
if ! command -v brew >/dev/null 2>&1; then
    echo '[dotfiles] Homebrew is missing; install it from https://brew.sh first.'
    exit 1
fi

brew bundle --file=- <<'BREWFILE'
brew "atuin"
brew "carapace"
brew "fnm"
brew "fzf"
brew "starship"
brew "uv"
brew "zoxide"
BREWFILE
{{- end }}
